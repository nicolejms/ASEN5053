GMAT EarthOrbit.ViewPointVector = [ 0 0 30000 ];
GMAT EarthOrbit.ViewDirection = Earth;
GMAT EarthOrbit.ViewScaleFactor = 1;
GMAT EarthOrbit.ViewUpCoordinateSystem = EarthInertial;
GMAT EarthOrbit.ViewUpAxis = Z;

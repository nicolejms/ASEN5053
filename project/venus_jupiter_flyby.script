%----------------------------------------
%---------- Mission Sequence
%----------------------------------------

BeginMissionSequence;
Target DefaultDC {SolveMode = Solve, ExitMode = SaveAndContinue, ShowProgressWindow = false};
   Vary 'VaryX' DefaultDC(Cassini.X = -148931680.2832679, {Perturbation = 0.0001, Lower = -1.489416802832679E+08, Upper = -1.489216802832679E+08, MaxStep = 10000, AdditiveScaleFactor = 0.0, MultiplicativeScaleFactor = 1.0});
   Vary 'VaryY' DefaultDC(Cassini.Y = 16155954.54555795, {Perturbation = 0.0001, Lower = 1.615495454555795E+07, Upper = 1.615695454555795E+07, MaxStep = 100001.615595454555795E+07, AdditiveScaleFactor = 0.0, MultiplicativeScaleFactor = 1.0});
   Vary 'VaryZ' DefaultDC(Cassini.Z = 30634.025006474, {Perturbation = 0.0001, Lower = 3.063302500647400E+04, Upper = 3.063502500647400E+04, MaxStep = 10000, AdditiveScaleFactor = 0.0, MultiplicativeScaleFactor = 1.0});
   Vary 'VaryVx' DefaultDC(Cassini.VX = -3.8047834692746, {Perturbation = 0.001, Lower = -3.80578346927460, Upper = -3.80378346927460, MaxStep = 0.1, AdditiveScaleFactor = 0.0, MultiplicativeScaleFactor = 1.0});
   Vary 'VaryVy' DefaultDC(Cassini.VY = -4, {Perturbation = 0.001, Lower = -4.001, Upper = -3.999, MaxStep = 0.1, AdditiveScaleFactor = 0.0, MultiplicativeScaleFactor = 1.0});
   Vary 'VaryVz' DefaultDC(Cassini.VZ = 0.0004954877820022574, {Perturbation = 0.001, Lower = 4.953877820022574E-04, Upper = 4.955877820022574E-04, MaxStep = 0.1, AdditiveScaleFactor = 0.0, MultiplicativeScaleFactor = 1.0});
   Report DefaultReportFile Cassini.A1ModJulian;
   Propagate 'Prop to Earth SOI Departure' EarthPM(Cassini) {Cassini.Earth.RMAG = 929000};
   Report DefaultReportFile Cassini.A1ModJulian;
   Propagate 'Prop to Venus SOI Arrival' VenusPM(Cassini) {Cassini.Venus.RMAG = 616000, StopTolerance = 1e-05, OrbitColor = [255 0 255]};
   Report DefaultReportFile Cassini.A1ModJulian;
   Propagate 'Prop to Venus Periapsis' VenusPM(Cassini) {Cassini.Venus.Periapsis, StopTolerance = 1e-05, OrbitColor = [255 0 0]};
   Report DefaultReportFile Cassini.A1ModJulian;
   Propagate 'Prop to SOI Departure' VenusPM(Cassini) {Cassini.Venus.RMAG = 616000, OrbitColor = [255 0 0]};
   Report DefaultReportFile Cassini.A1ModJulian;
   Propagate 'Prop to Jupiter SOI Arrival' SunPM(Cassini) {Cassini.Jupiter.RMAG = 48200000, StopTolerance = 1e-05, OrbitColor = [0 0 255]};
   Report DefaultReportFile Cassini.A1ModJulian;
   Propagate 'Prop to Jupiter Periapsis' DefaultProp(Cassini) {Cassini.ElapsedSecs = 12000.0};
   Report DefaultReportFile Cassini.A1ModJulian;
   Achieve 'AchieveRp' DefaultDC(Cassini.Jupiter.RadPer = 1000000, {Tolerance = 1});
EndTarget;  % For targeter DefaultDC

GMAT MarsOrbit.EnableStars = On;
GMAT MarsOrbit.EnableConstellations = Off;

Create OrbitView VenusOrbit;
GMAT VenusOrbit.SolverIterations = Current;
GMAT VenusOrbit.UpperLeft = [ 0.2007648183556405 0.3118741058655222 ];
GMAT VenusOrbit.Size = [ 0.5003186743148502 0.5350500715307582 ];
GMAT VenusOrbit.RelativeZOrder = 910;
